#!/usr/bin/env bash
# .githooks/post-commit
# Part of WP-453: Конвейер обновления раздела 7 guide
# Триггер Т3: Явная разметка [guide-update: S7.SS_N] в commit message
#
# Вызывается ПОСЛЕ создания коммита: HEAD уже новый коммит — в section-state.yaml
# попадает правильный SHA (в commit-msg попадал SHA предыдущего коммита — баг,
# найден Codex в пир-сессии 2026-07-31-22-wp453-t3-hook-test). Плюс: падение
# другого хука до завершения коммита больше не оставляет ложный триггер.

set -uo pipefail  # без -e: сбой побочного конвейера не должен валить git-поток

REGISTRY_REPO="${IWE_REGISTRY_REPO:-$HOME/IWE/DS-my-strategy}"

T3_SCRIPT="${REGISTRY_REPO}/scripts/fp453-t3-mark-guide-update.sh"
if [[ ! -f "$T3_SCRIPT" ]]; then
  # OK — конвейер WP-453 может быть не установлен в этой инсталляции
  exit 0
fi

COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null || echo "")
COMMIT_SHA=$(git rev-parse HEAD 2>/dev/null || echo "")

if ! "$T3_SCRIPT" "$COMMIT_MSG" "$COMMIT_SHA"; then
  # Не блокируем (commit-msg/post-commit не должны валить коммит из-за
  # внешнего registry-репо), но и не молчим (Codex, 2026-07-31-22).
  echo "WARN: WP-453 T3 trigger failed for commit ${COMMIT_SHA:0:8} — см. $T3_SCRIPT" >&2
fi

exit 0
